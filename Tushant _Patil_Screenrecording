export const DraggableNode = ({ type, label, accent, io }) => {
  const onDragStart = (event) => {
    const appData = { nodeType: type };
    event.dataTransfer.setData('application/reactflow', JSON.stringify(appData));
    event.dataTransfer.effectAllowed = 'move';
    event.currentTarget.style.cursor = 'grabbing';
  };

  const onDragEnd = (event) => {
    event.currentTarget.style.cursor = 'grab';
  };

  return (
    <div
      className="vs-draggable-node"
      style={{ '--accent-node': accent }}
      draggable
      onDragStart={onDragStart}
      onDragEnd={onDragEnd}
    >
      <span className="vs-draggable-chip" />
      <span className="vs-draggable-label">{label}</span>
      {io && <span className="vs-draggable-io">{io}</span>}
    </div>
  );
};
