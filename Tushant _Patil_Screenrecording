## `frontend/src/nodes/nodeFactory.jsx`

```jsx
import { BaseNode } from './BaseNode';

/**
 * createNode(config) is the entire "new node" abstraction. Instead of
 * copy-pasting a node file and rewriting handles/state wiring, a new
 * node type is just a config object describing what it looks like:
 *
 *   export const MathNode = createNode({
 *     type: 'math',
 *     title: 'Math Operation',
 *     accent: '#db2777',
 *     fields: [{ name: 'operation', label: 'Operation', type: 'select', options: [...] }],
 *     handles: [
 *       { id: 'a', type: 'target', position: Position.Left, style: { top: '35%' } },
 *       { id: 'b', type: 'target', position: Position.Left, style: { top: '65%' } },
 *       { id: 'result', type: 'source', position: Position.Right },
 *     ],
 *   });
 *
 * `fields` and `handles` may also be functions of (data, id) so a node's
 * shape can react to its own state (this is how the Text node grows new
 * handles as the user types new {{variables}} - see TextNode.jsx).
 */
export function createNode(config) {
  const NodeComponent = ({ id, data }) => {
    const fields = typeof config.fields === 'function' ? config.fields(data, id) : config.fields || [];
    const handles = typeof config.handles === 'function' ? config.handles(data, id) : config.handles || [];

    return (
      <BaseNode
        id={id}
        data={data}
        title={config.title}
        accent={config.accent}
        fields={fields}
        handles={handles}
        ioTag={config.ioTag}
        minWidth={config.minWidth}
      >
        {config.render ? config.render(data, id) : null}
      </BaseNode>
    );
  };

  NodeComponent.displayName = `Node(${config.type})`;
  return NodeComponent;
}
