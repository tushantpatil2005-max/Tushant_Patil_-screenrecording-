## `frontend/src/nodes/BaseNode.jsx`

```jsx
import { useCallback } from 'react';
import { Handle } from 'reactflow';
import { useStore } from '../store';
import './nodes.css';

/**
 * BaseNode renders the shared chrome for every node on the canvas: a
 * silkscreen-style header, a body of config fields, and a set of
 * connection handles (ports). Individual node types are defined by
 * *config* (see nodeFactory.jsx) rather than by writing new markup,
 * so adding a node is a matter of describing its fields/handles.
 *
 * Props:
 *  - id, data          : standard ReactFlow node props
 *  - title             : display name shown in the header
 *  - accent            : hex color used for this node type's chip/border/ports
 *  - fields            : [{ name, label, type, options?, defaultValue?, rows? }]
 *  - handles           : [{ id, type: 'source'|'target', position, label?, style? }]
 *  - ioTag             : optional override string for the header's io count tag
 *  - children          : extra custom content rendered below the fields
 */
export const BaseNode = ({
  id,
  data,
  title,
  accent = '#e8933a',
  fields = [],
  handles = [],
  ioTag,
  minWidth = 220,
  children,
}) => {
  const updateNodeField = useStore((state) => state.updateNodeField);

  const handleChange = useCallback(
    (fieldName, value) => {
      updateNodeField(id, fieldName, value);
    },
    [id, updateNodeField]
  );

  const inCount = handles.filter((h) => h.type === 'target').length;
  const outCount = handles.filter((h) => h.type === 'source').length;
  const computedIoTag = ioTag ?? `IN·${inCount} OUT·${outCount}`;

  return (
    <div className="vs-node" style={{ minWidth, '--accent-node': accent }}>
      <div className="vs-node-header">
        <span className="vs-node-chip" />
        <span className="vs-node-title">{title}</span>
        <span className="vs-node-io-tag">{computedIoTag}</span>
      </div>

      <div className="vs-node-body">
        {fields.map((field) => (
          <div className="vs-field" key={field.name}>
            <label className="vs-field-label">{field.label}</label>
            {renderField(field, data, handleChange)}
          </div>
        ))}
        {children}
      </div>

      {handles.map((handle) => (
        <Handle
          key={handle.id}
          id={handle.id}
          type={handle.type}
          position={handle.position}
          style={handle.style}
          className={`vs-handle vs-handle-${handle.type}`}
        />
      ))}
    </div>
  );
};

function renderField(field, data, handleChange) {
  const value = data?.[field.name] ?? field.defaultValue ?? '';

  switch (field.type) {
    case 'select':
      return (
        <select
          className="vs-select"
          value={value}
          onChange={(e) => handleChange(field.name, e.target.value)}
        >
          {field.options.map((opt) => (
            <option key={opt.value} value={opt.value}>
              {opt.label}
            </option>
          ))}
        </select>
      );

    case 'textarea':
      return (
        <textarea
          className="vs-textarea"
          rows={field.rows || 2}
          value={value}
          onChange={(e) => handleChange(field.name, e.target.value)}
        />
      );

    case 'number':
      return (
        <input
          type="number"
          className="vs-input"
          value={value}
          onChange={(e) => handleChange(field.name, e.target.value)}
        />
      );

    case 'checkbox':
      return (
        <div className="vs-node-checkbox-row">
          <input
            type="checkbox"
            checked={!!value}
            onChange={(e) => handleChange(field.name, e.target.checked)}
          />
        </div>
      );

    default:
      return (
        <input
          type="text"
          className="vs-input"
          value={value}
          onChange={(e) => handleChange(field.name, e.target.value)}
        />
      );
  }
}
```

